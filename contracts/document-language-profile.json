      "independent_mapping": "PENDING_HUMAN_SOURCE_REVIEW"
    },
    {
      "id": "plain-terms",
      "criterion": "Prefer the declared project plain-term substitutions",
      "local": true,
      "independent_mapping": "PENDING_HUMAN_SOURCE_REVIEW"
    },
    {
      "id": "single-instruction-heuristic",
      "criterion": "Flag semicolon-separated instructions",
      "local": true,
      "independent_mapping": "PENDING_HUMAN_SOURCE_REVIEW"
    },
    {
      "id": "controlled-dictionary",
      "criterion": "Require source-backed glossary authority for every eligible lexical word",
      "local": false,
      "independent_mapping": "PENDING_HUMAN_SOURCE_REVIEW"
    },
    {
      "id": "part-of-speech",
      "criterion": "Check authorized grammatical use against the supplied glossary",
      "local": false,
      "independent_mapping": "PENDING_HUMAN_SOURCE_REVIEW"
    },
    {
      "id": "active-voice",
      "criterion": "Check identified actor and active instructions where applicable",
      "local": false,
      "independent_mapping": "PENDING_HUMAN_SOURCE_REVIEW"
    },
    {
      "id": "term-consistency",
      "criterion": "Check canonical project terminology across the complete supplied candidate",
      "local": false,
      "independent_mapping": "PENDING_HUMAN_SOURCE_REVIEW"
    },
    {
      "id": "ambiguity",
      "criterion": "Check actors, scope, references, conditions and temporal order; insufficient context is unknown",
      "local": false,
      "independent_mapping": "PENDING_HUMAN_SOURCE_REVIEW"
    }
  ]
