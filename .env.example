# Architect Agent Framework v2.0 — Environment Configuration (.env)
# Copy to .env in your workspace or ~/.architect-framework/.env.
# Process environment variables take precedence over values in .env.

# --- 1. Sharded Semantic & Language Review Judge (Zero-Config Discovery) ---
# Set any one of SDD_JUDGE_API_KEY, JEV_API_KEY, JEV_KEY, OPENAI_API_KEY, or GEMINI_API_KEY
SDD_JUDGE_API_KEY=
JEV_API_KEY=

# Judge provider protocol: 'typesafe-jev' or 'openai-compatible'
SDD_JUDGE_TYPE=openai-compatible

# Judge model identifier (e.g. gemini-3.8-flash-high, jev-2.5-pro, gpt-4o)
SDD_JUDGE_MODEL=gemini-3.8-flash-high

# Judge API endpoint URL
SDD_JUDGE_ENDPOINT=https://api.openai.com/v1/chat/completions

# Per-candidate cost ceiling in USD and per-call timeout in seconds
SDD_JUDGE_MAX_COST_USD=5.0
SDD_JUDGE_TIMEOUT_SECONDS=90

# --- 2. Runtime Interpreter & Skill Slots ---
# Optional path to Python 3.10+ interpreter with runtime dependencies
ARCHITECT_PYTHON=

# Optional colon/semicolon-separated search path for custom or licensed skill packs
ARCHITECT_SKILLS_PATH=

# Allow base contract execution when optional specialist skill slots are empty (0 or 1)
ARCHITECT_ALLOW_BASE=1
